{
  "name": "@mukco/ui-kit",
  "version": "0.1.0",
  "description": "Estate-wide UI kit: semantic tokens, primitives, charts, sports identity seam.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "default": "./dist/observability/index.js"
    },
    "./observability/core": {
      "types": "./dist/observability/core.d.ts",
      "default": "./dist/observability/core.js"
    },
    "./push": {
      "types": "./dist/primitives/push.d.ts",
      "default": "./dist/primitives/push.js"
    },
    "./ui.css": "./dist/ui.css",
    "./ui-components.css": "./dist/ui-components.css",
    "./phosphor.css": "./dist/phosphor.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
    "check": "tsc -p tsconfig.json && npm run check:conventions",
    "check:conventions": "node scripts/check-conventions.mjs",
    "dev": "vite",
    "test": "npm run build && node --test test/updateReady.test.mjs test/playerNames.test.mjs test/observability.test.mjs test/push.test.mjs",
    "visual": "node scripts/visual.mjs",
    "visual:update": "node scripts/visual.mjs --update"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@uiw/react-codemirror": "^4.25.11",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "pixelarticons": "^2.4.2",
    "react-markdown": "^10.1.0",
    "react-pivottable": "^0.11.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-pivottable": "^0.11.6",
    "@vitejs/plugin-react": "^6.0.4",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
